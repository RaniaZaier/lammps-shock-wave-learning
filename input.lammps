# LAMMPS Input Script: Shock Wave Propagation in Aluminum
# Rania Zaier - 2026

# Initialization
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# Create aluminum FCC lattice
lattice         fcc 4.05
region          box block 0 20 0 10 0 10
create_box      1 box
create_atoms    1 box
mass            1 26.98

# EAM potential for Aluminum
pair_style      eam/alloy
pair_coeff      * * Al99.eam.alloy Al

# Initial velocity (thermal)
velocity        all create 300.0 87287 mom yes rot yes dist gaussian

# Define regions for shock generation
region          impact block 0 2 INF INF INF INF
group           impact region impact

# Time integration
timestep        0.001

# Compute properties
compute         temp all temp
compute         press all pressure thermo_temp
compute         pe all pe/atom
compute         ke all ke/atom

# Thermodynamic output
thermo          100
thermo_style    custom step temp press pe ke vol

# Dump atom positions for visualization
dump            1 all custom 200 dump.lammpstrj id type x y z vx vy vz c_pe c_ke
dump_modify     1 sort id

# Apply shock impulse
velocity        impact set 5.0 0.0 0.0 units box

# NVE ensemble
fix             1 all nve

# Run simulation
run             10000

write_data      final_config.data

print           "Simulation completed!"

